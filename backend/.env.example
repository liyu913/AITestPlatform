MYSQL_DSN=mysql+pymysql://raina:raina@127.0.0.1:3306/raina
JWT_SECRET=change-me-in-env
# 可与 LLM 共用同一 DashScope API Key；默认模型 text-embedding-v2（1536 维）
EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v2
# EMBEDDING_DIM=1536
# 通义千问（DashScope）：与 LLM_API_BASE 对应使用阿里云 API Key
LLM_API_KEY=
# 默认已指向兼容 OpenAI 的 DashScope 地址，可按需覆盖：
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-vl-plus
# Fernet key. Local default below; regenerate for production:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=lOaibadCJM2dC3_Ne0xhlxlD9FbzVs_M8xOGboKlyP8=
# Comma-separated; leave empty to allow only LLM_MODEL
# MIDSCENE_MODEL_API_KEY=
# MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIDSCENE_MODEL_NAME=qwen-vl-plus
# MIDSCENE_MODEL_FAMILY=qwen2.5-vl
# UI 探索 Node 运行器：在仓库 ui-runner 目录执行 npm install，再执行 npx playwright install chromium
# 登录必须图形验证码（生产建议 true；单测 conftest 会关）
# REQUIRE_LOGIN_CAPTCHA=true
# 是否允许公开自助注册（生产可设 false）
# ALLOW_OPEN_REGISTRATION=true
# 超级管理员：API 启动时若不存在则自动创建（默认 admin / admin123）；忘记密码可 python -m app.bootstrap 强制重置
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=admin123
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# UI 自动化：Worker 需另执行 `uv run playwright install chromium`
# APP 自动化：Worker 需本机/内网 Appium Server + Android 模拟器或真机（队列名默认 app）
# 设备池「扫描本机」需本机安装 adb（Platform-Tools）；可选覆盖路径：
# ADB_BIN=adb
# ADB_BIN=C:\Android\platform-tools\adb.exe
